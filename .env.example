# Required. Generate: openssl rand -hex 32
AGENTICFORM_ADMIN_TOKEN=

# Public browser URL. Keep localhost for a local deployment; use HTTPS elsewhere.
AGENTICFORM_PUBLIC_URL=http://localhost:8080
AGENTICFORM_UI_ORIGIN=http://localhost:8080

# Release image tag. Pin to a published release for production.
AGENTICFORM_VERSION=latest
AGENTICFORM_SERVER_IMAGE=ghcr.io/raufimusaddiq/agenticform-server:latest
AGENTICFORM_WEB_IMAGE=ghcr.io/raufimusaddiq/agenticform-web:latest
AGENTICFORM_NODE_IMAGE=ghcr.io/raufimusaddiq/agenticform-node:latest

# Change these before exposing PostgreSQL-backed storage beyond localhost.
POSTGRES_DB=agenticform
POSTGRES_USER=agenticform
POSTGRES_PASSWORD=agenticform

# Host directory mounted for project discovery/materialization.
AGENTICFORM_PROJECT_ROOT=/srv/apps
AGENTICFORM_WEB_PORT=8080
