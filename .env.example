# Required. Generate: openssl rand -hex 32
AGENTICFORM_ADMIN_TOKEN=
# Optional separate AES-256 key material for encrypted project credentials.
AGENTICFORM_SECRET_KEY=

# Public browser URL. Keep localhost for a local deployment; use HTTPS elsewhere.
AGENTICFORM_PUBLIC_URL=http://localhost:8080
AGENTICFORM_UI_ORIGIN=http://localhost:8080

# Replace <release-tag> with one published by the Release images workflow.
AGENTICFORM_VERSION=<release-tag>
AGENTICFORM_SERVER_IMAGE=ghcr.io/raufimusaddiq/agenticform-server:<release-tag>
AGENTICFORM_WEB_IMAGE=ghcr.io/raufimusaddiq/agenticform-web:<release-tag>
AGENTICFORM_NODE_IMAGE=ghcr.io/raufimusaddiq/agenticform-node:<release-tag>

# Change these before exposing PostgreSQL-backed storage beyond localhost.
POSTGRES_DB=agenticform
POSTGRES_USER=agenticform
POSTGRES_PASSWORD=agenticform

# Host directory mounted for project discovery/materialization.
AGENTICFORM_PROJECT_ROOT=/srv/apps
AGENTICFORM_WEB_PORT=8080
# PostgreSQL binds only on loopback. Omit this unless the host port must change.
AGENTICFORM_POSTGRES_PORT=5432
